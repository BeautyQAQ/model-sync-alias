# Copy this file to .env and replace every /absolute/path placeholder.
# Never commit the resulting .env file or put real credentials in this example.

# Build toolchain
GO_BIN=go
CC=cc

# Local checkout and CLIProxyAPI installation
PROJECT_DIR=/absolute/path/to/model-sync-alias
CPA_DIR=/absolute/path/to/cliproxyapi
CPA_CONFIG_PATH=/absolute/path/to/cliproxyapi/config.yaml
CPA_BINARY=/absolute/path/to/cliproxyapi/cli-proxy-api
CPA_PLUGIN_SO=/absolute/path/to/model-sync-alias/axonhub-model-sync.so
CPA_SERVICE=cliproxyapi.service

# Authenticated CPA Management API
CPA_MANAGEMENT_URL=http://127.0.0.1:8317
CPA_MANAGEMENT_KEY=

# Optional tests
CPA_INTEGRATION=0
# Keep empty during normal test runs. Set explicitly to CPA_CONFIG_PATH for live audits.
AXONHUB_LIVE_CONFIG=
